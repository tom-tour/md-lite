#include <winver.h>

1 ICON "md-lite.ico"
1 24 "md-lite.manifest"

1 VERSIONINFO
FILEVERSION 2,1,1,0
PRODUCTVERSION 2,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "MD Lite"
      VALUE "ProductName", "MD Lite"
      VALUE "FileVersion", "2.1.1"
      VALUE "ProductVersion", "2.1.1"
      VALUE "OriginalFilename", "md-lite.exe"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
